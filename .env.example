# ===== 观势 · 环境变量示例 =====
# 复制本文件为 .env 并填写；.env 已在 .gitignore 中，不会提交到仓库

# 扶摇（同花顺金融数据 API）Key：https://fuyao.aicubes.cn 登录后在「API Key 管理」签发
FUYAO_API_KEY=

# 大模型（OpenAI 兼容接口）。默认 DeepSeek；不填则自动降级为「规则模板叙述」，页面会明确标注
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 服务端口
PORT=8787
